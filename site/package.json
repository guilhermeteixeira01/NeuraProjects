{
  "name": "neura-site",
  "private": true,
  "version": "2.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:local": "vite --mode teste",
    "worker:local": "cd worker/steam-login && npx wrangler dev --port 8787",
    "teste:local": "node worker/steam-login/dev/dev.mjs",
    "build": "vite build && vite build --ssr src/ssr.jsx --outDir dist-ssr",
    "gerar": "node scripts/gerar-site.mjs --dados .. --saida dist-final",
    "preview": "vite preview --outDir dist-final"
  },
  "dependencies": {
    "@jsquash/webp": "^1.5.0",
    "fast-png": "^8.0.0",
    "image-size": "^2.0.4",
    "jpeg-js": "^0.4.4",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^5.0.0",
    "vite": "^7.0.0"
  }
}
